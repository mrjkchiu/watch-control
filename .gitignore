# ---- 依赖 / 构建缓存（体积大、可再生，不入库）----
node_modules/
.gradle/
**/.gradle/
**/build/
build/
dist/
capture/
local.properties
.idea/
*.iml
.cxx/

# ---- 编译产物 / 交付物（由 build.sh / deliver.sh 生成）----
*.apk
*.rpk
*.tgz
/交付/

# ---- 签名材料（不入库：私钥一旦进入 Git 历史极难彻底清除）----
# 签名文件仅保留在本地用于同签名打包；换设备需单独拷贝 keys/ 与 watch-rpk/sign/。
keys/
watch-rpk/sign/
*.p12
*.pem

# ---- 运行时抓取的敏感数据 ----
*dsh-token*
*.log
