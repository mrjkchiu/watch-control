<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.watchctl.hook">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 包可见性：显式广播到 companion、dsh.open 拉起引擎页需要。
         0.1.2 起 wb.prompt 走引擎 session/prompt，不再依赖 ACTION_SEND 分享页。 -->
    <queries>
        <package android:name="com.example.watchctl" />
        <package android:name="com.tencent.workbuddy.app" />
    </queries>

    <application
        android:name=".RelayApplication"
        android:label="腕控 · 主中继"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light">

        <!-- 0.1.1 关键：指令接收静态注册。显式广播(setPackage=com.watchctl.hook) 可唤醒
             模块进程并回调本接收器，不依赖 RelayService 是否常驻。
             exported=true 必须保留（companion 是另一个应用）；鉴权由 CommandProcessor 的
             watchctl_token 校验负责。 -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.watchctl.CMD" />
                <action android:name="com.watchctl.SET" />
            </intent-filter>
        </receiver>

        <!-- 仅前台保活，不再注册指令接收器（避免与静态接收器重复处理同一条指令） -->
        <service
            android:name=".RelayService"
            android:exported="false"
            android:process=":relay"
            android:foregroundServiceType="dataSync" />

        <!-- 声明为 Xposed 模块，LSPosed 据此识别 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="腕控主中继：收 companion 广播→dsh-go 引擎(3080) session/prompt 写入 WorkBuddy→结果回广播" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <!-- 建议作用域：WorkBuddy 必勾，系统框架按需勾 -->
        <meta-data android:name="xposedscope" android:resource="@array/module_scope" />

        <activity android:name=".SettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
